@startuml koncept
' Schemat ER - Salon Samochodowy - Model Konceptualny
' Notacja: Chen/Crow's Foot
' Format pionowy (A4)

skinparam ranksep 100
skinparam nodesep 40
skinparam defaultFontName "Arial"

entity "SALON" as salon {
  * **nr_salonu** : PK
  --
  * nazwa : VARCHAR(100) <<UK>>
  * <<composite>> adres
    ** ulica : VARCHAR(100)
    ** miasto : VARCHAR(50)
    ** kod_pocztowy : CHAR(6)
  * telefon : VARCHAR(15)
  * email : VARCHAR(100)
}

entity "PRACOWNIK" as pracownik {
  * **nr_pracownika** : PK
  --
  * imie : VARCHAR(50)
  * nazwisko : VARCHAR(50)
  * pesel : CHAR(11) <<UK>>
  * stanowisko : VARCHAR(50)
  * data_zatrudnienia : DATE
  * pensja_podstawowa : NUMBER(10,2)
}

entity "SPRZEDAWCA" as sprzedawca {
  * **nr_pracownika** : PK, FK
  --
  * prowizja_procent : NUMBER(5,2)
  * limit_rabatu_procent : NUMBER(5,2)
  liczba_sprzedazy : NUMBER(5)
}

entity "SERWISANT" as serwisant {
  * **nr_pracownika** : PK, FK
  --
  * specjalizacja : VARCHAR(100)
  <<multivalued>> certyfikaty : VARCHAR(500)
  * stawka_godzinowa : NUMBER(10,2)
}

entity "POJAZD" as pojazd {
  * **nr_vin** : PK, CHAR(17)
  --
  * rok_produkcji : NUMBER(4)
  * przebieg : NUMBER(10)
  * kolor : VARCHAR(30)
  * cena_katalogowa : NUMBER(10,2)
  * stan : {Nowy, Uzywany}
  * status : {Dostepny, Sprzedany,\nRezerwacja, Serwis}
  * data_przyjecia : DATE
  uwagi : VARCHAR(500)
}

entity "MODEL_SAMOCHODU" as model {
  * **id_modelu** : PK
  --
  * nazwa_modelu : VARCHAR(50)
  * typ_nadwozia : {Sedan, SUV,\nHatchback, Kombi}
  * pojemnosc_silnika : NUMBER(3,1)
  * moc_km : NUMBER(4)
  * rodzaj_paliwa : {Benzyna, Diesel,\nElektryczny, Hybryda}
  * liczba_miejsc : NUMBER(1)
}

entity "PRODUCENT" as producent {
  * **id_producenta** : PK
  --
  * nazwa_producenta : VARCHAR(50) <<UK>>
  * kraj_pochodzenia : VARCHAR(50)
}

entity "SPRZEDAZ" as sprzedaz {
  * **nr_sprzedazy** : PK
  --
  * data_sprzedazy : DATE
  * cena_sprzedazy : NUMBER(10,2)
  * cena_koncowa : NUMBER(10,2)
  * metoda_platnosci : {Gotowka,\nPrzelew, Finansowanie, Leasing}
  * status : {W_trakcie,\nZakonczona, Anulowana}
}

entity "KLIENT" as klient {
  * **nr_klienta** : PK
  --
  * typ_klienta : {Indywidualny, Firma}
  <<composite>> dane_osobowe
    ** imie : VARCHAR(50)
    ** nazwisko : VARCHAR(50)
    ** pesel : CHAR(11) <<UK>>
  <<composite>> dane_firmowe
    ** nazwa_firmy : VARCHAR(100)
    ** nip : CHAR(10) <<UK>>
  * <<composite>> adres
  * telefon : VARCHAR(15)
  * email : VARCHAR(100)
  * data_rejestracji : DATE
}

entity "WYPOSAZENIE" as wyposazenie {
  * **id_wyposazenia** : PK
  --
  * nazwa : VARCHAR(100) <<UK>>
  * kategoria : {Bezpieczenstwo,\nKomfort, Multimedia}
  * dodatkowa_cena : NUMBER(10,2)
}

entity "TEST_DRIVE" as test_drive {
  * **nr_klienta** : PK, FK
  * **nr_vin** : PK, FK
  * **data_jazdy** : PK
  --
  godzina : TIME
  nr_prawa_jazdy : VARCHAR(20)
  status : VARCHAR(20)
}

entity "POJAZD_WYPOSAZENIE" as pojazd_wyp {
  * **nr_vin** : PK, FK
  * **id_wyposazenia** : PK, FK
}

salon -down-> pracownik : "zatrudnia\n(1,1):(0,N)"
salon -down-> pojazd : "posiada\n(1,1):(0,N)"

pracownik -down-> sprzedawca : "<<ISA>>\nOverlapping\nPartial"
pracownik -down-> serwisant : "<<ISA>>\nOverlapping\nPartial"

pracownik -down-> sprzedaz : "realizuje\n(1,1):(0,N)"

pojazd -down-> model : "jest_instancja\n(1,1):(1,N)"
pojazd -down-> sprzedaz : "jest_przedmiotem\n(1,1):(0,1)"
pojazd -down-> pojazd_wyp : "(1,N)"
pojazd -down-> test_drive : "(0,N)"

model -down-> producent : "produkuje\n(1,1):(1,N)"

sprzedaz -down-> klient : "dokonuje\n(1,1):(0,N)"

klient -down-> test_drive : "(0,N)"

wyposazenie -down-> pojazd_wyp : "(0,N)"

note right of salon
  Encja glowna
  (lewy gorny rog)
end note

note right of pracownik
  Hierarchia specjalizacji:
  - Overlapping: pracownik moze
    byc jednoczesnie sprzedawca
    i serwisantem
  - Partial: nie kazdy pracownik
    musi miec specjalizacje
end note

@enduml
