@startuml koncept
' Schemat ER - Salon Samochodowy - Model Konceptualny
' Notacja: Chen/Crow's Foot

skinparam linetype ortho
skinparam ranksep 80
skinparam nodesep 60

' ============ ENCJE ============

entity "SALON" as salon {
  * **nr_salonu** : PK
  --
  * nazwa : VARCHAR(100) <<UK>>
  * <<composite>> adres
    ** ulica : VARCHAR(100)
    ** miasto : VARCHAR(50)
    ** kod_pocztowy : CHAR(6)
  * telefon : VARCHAR(15)
  * email : VARCHAR(100)
}

entity "POJAZD" as pojazd {
  * **nr_vin** : PK, CHAR(17)
  --
  * rok_produkcji : NUMBER(4)
  * przebieg : NUMBER(10)
  * kolor : VARCHAR(30)
  * cena_katalogowa : NUMBER(10,2)
  * stan : {Nowy, Uzywany}
  * status : {Dostepny, Sprzedany, Rezerwacja, Serwis}
  * data_przyjecia : DATE
  uwagi : VARCHAR(500)
}

entity "MODEL_SAMOCHODU" as model {
  * **id_modelu** : PK
  --
  * nazwa_modelu : VARCHAR(50)
  * typ_nadwozia : {Sedan, SUV, Hatchback, Kombi}
  * pojemnosc_silnika : NUMBER(3,1)
  * moc_km : NUMBER(4)
  * rodzaj_paliwa : {Benzyna, Diesel, Elektryczny, Hybryda}
  * liczba_miejsc : NUMBER(1)
}

entity "PRODUCENT" as producent {
  * **id_producenta** : PK
  --
  * nazwa_producenta : VARCHAR(50) <<UK>>
  * kraj_pochodzenia : VARCHAR(50)
}

entity "KLIENT" as klient {
  * **nr_klienta** : PK
  --
  * typ_klienta : {Indywidualny, Firma}
  <<composite>> dane_osobowe (dla Indywidualny)
    ** imie : VARCHAR(50)
    ** nazwisko : VARCHAR(50)
    ** pesel : CHAR(11) <<UK>>
  <<composite>> dane_firmowe (dla Firma)
    ** nazwa_firmy : VARCHAR(100)
    ** nip : CHAR(10) <<UK>>
  * <<composite>> adres
    ** ulica : VARCHAR(100)
    ** miasto : VARCHAR(50)
    ** kod_pocztowy : CHAR(6)
  * telefon : VARCHAR(15)
  * email : VARCHAR(100)
  * data_rejestracji : DATE
}

entity "PRACOWNIK" as pracownik {
  * **nr_pracownika** : PK
  --
  * imie : VARCHAR(50)
  * nazwisko : VARCHAR(50)
  * pesel : CHAR(11) <<UK>>
  * stanowisko : VARCHAR(50)
  * data_zatrudnienia : DATE
  * pensja_podstawowa : NUMBER(10,2)
}

entity "SPRZEDAWCA" as sprzedawca {
  * **nr_pracownika** : PK, FK
  --
  * prowizja_procent : NUMBER(5,2)
  * limit_rabatu_procent : NUMBER(5,2)
  liczba_sprzedazy : NUMBER(5)
}

entity "SERWISANT" as serwisant {
  * **nr_pracownika** : PK, FK
  --
  * specjalizacja : VARCHAR(100)
  <<multivalued>> certyfikaty : VARCHAR(500)
  * stawka_godzinowa : NUMBER(10,2)
}

entity "SPRZEDAZ" as sprzedaz {
  * **nr_sprzedazy** : PK
  --
  * data_sprzedazy : DATE
  * cena_sprzedazy : NUMBER(10,2)
  * cena_koncowa : NUMBER(10,2)
  * metoda_platnosci : {Gotowka, Przelew, Finansowanie, Leasing}
  * status : {W_trakcie, Zakonczona, Anulowana}
}

entity "WYPOSAZENIE" as wyposazenie {
  * **id_wyposazenia** : PK
  --
  * nazwa : VARCHAR(100) <<UK>>
  * kategoria : {Bezpieczenstwo, Komfort, Multimedia}
  * dodatkowa_cena : NUMBER(10,2)
}

' Encja łącząca dla M:N
entity "TEST_DRIVE" as test_drive {
  * **nr_klienta** : PK, FK
  * **nr_vin** : PK, FK
  * **data_jazdy** : PK
  --
  godzina : TIME
  nr_prawa_jazdy : VARCHAR(20)
  status : VARCHAR(20)
}

entity "POJAZD_WYPOSAZENIE" as pojazd_wyp {
  * **nr_vin** : PK, FK
  * **id_wyposazenia** : PK, FK
}

' ============ ZWIĄZKI 1:M ============

salon ||--o{ pojazd : "posiada\n(1,1):(0,N)"
salon ||--o{ pracownik : "zatrudnia\n(1,1):(0,N)"
producent ||--|{ model : "produkuje\n(1,1):(1,N)"
model ||--|{ pojazd : "jest_instancja\n(1,1):(1,N)"
klient ||--o{ sprzedaz : "dokonuje\n(1,1):(0,N)"
pracownik ||--o{ sprzedaz : "realizuje\n(1,1):(0,N)"
pojazd ||--o| sprzedaz : "jest_przedmiotem\n(1,1):(0,1)"

' ============ ZWIĄZKI M:N (przez tabele łączące) ============

klient ||--o{ test_drive : "(0,N)"
test_drive }o--|| pojazd : "(0,N)"

pojazd ||--|{ pojazd_wyp : "(1,N)"
pojazd_wyp }o--|| wyposazenie : "(0,N)"

' ============ HIERARCHIA ISA (specjalizacja) ============

pracownik ||--o{ sprzedawca : "<<ISA>>\nOverlapping\nPartial"
pracownik ||--o{ serwisant : "<<ISA>>\nOverlapping\nPartial"

note right of salon
  Encja główna
  (lewy górny róg)
end note

note right of pracownik
  Hierarchia specjalizacji:
  - Overlapping: pracownik może
    być jednocześnie sprzedawcą
    i serwisantem
  - Partial: nie każdy pracownik
    musi mieć specjalizację
end note

note bottom of test_drive
  Encja łącząca dla M:N
  KLIENT <-> POJAZD
  (jazdy testowe)
end note

note bottom of pojazd_wyp
  Encja łącząca dla M:N
  POJAZD <-> WYPOSAZENIE
end note

@enduml
