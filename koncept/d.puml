@startuml kon
' Schemat ER - Salon Samochodowy - Model Konceptualny
' Notacja: Crow's Foot (Kurza Stopka)
' Zgodność:
' - Bezpośredni związek M:N dla Wyposażenia (bez tabeli łączącej)
' - Encje w l.poj.
' - Brak kluczy obcych (FK) w atrybutach

skinparam linetype ortho
skinparam ranksep 80
skinparam nodesep 60
skinparam defaultFontName "Arial"
skinparam entity {
    BackgroundColor #FEFECE
    BorderColor #A80036
}

' ============ ENCJE ============

entity "SALON" as salon {
  * **nr_salonu** : PK
  --
  * nazwa : VARCHAR(100) <<UK>>
  * <<composite>> adres
    ** ulica : VARCHAR(100)
    ** miasto : VARCHAR(50)
    ** kod_pocztowy : CHAR(6)
  * telefon : VARCHAR(15)
  * email : VARCHAR(100)
}

entity "POJAZD" as pojazd {
  * **nr_vin** : PK, CHAR(17)
  --
  * rok_produkcji : NUMBER(4)
  * przebieg : NUMBER(10)
  * kolor : VARCHAR(30)
  * cena_katalogowa : NUMBER(10,2)
  * stan : {Nowy, Uzywany}
  * status : {Dostepny, Sprzedany, Rezerwacja, Serwis}
  * data_przyjecia : DATE
  uwagi : VARCHAR(500)
}

entity "MODEL_SAMOCHODU" as model {
  * **id_modelu** : PK
  --
  * nazwa_modelu : VARCHAR(50)
  * typ_nadwozia : {Sedan, SUV, Hatchback, Kombi}
  * pojemnosc_silnika : NUMBER(3,1)
  * moc_km : NUMBER(4)
  * rodzaj_paliwa : {Benzyna, Diesel, Elektryczny, Hybryda}
  * liczba_miejsc : NUMBER(1)
}

entity "PRODUCENT" as producent {
  * **id_producenta** : PK
  --
  * nazwa_producenta : VARCHAR(50) <<UK>>
  * kraj_pochodzenia : VARCHAR(50)
}

entity "KLIENT" as klient {
  * **nr_klienta** : PK
  --
  * typ_klienta : {Indywidualny, Firma}
  <<composite>> dane_osobowe (dla Indywidualny)
    ** imie : VARCHAR(50)
    ** nazwisko : VARCHAR(50)
    ** pesel : CHAR(11) <<UK>>
  <<composite>> dane_firmowe (dla Firma)
    ** nazwa_firmy : VARCHAR(100)
    ** nip : CHAR(10) <<UK>>
  * <<composite>> adres
  * telefon : VARCHAR(15)
  * email : VARCHAR(100)
  * data_rejestracji : DATE
}

entity "PRACOWNIK" as pracownik {
  * **nr_pracownika** : PK
  --
  * imie : VARCHAR(50)
  * nazwisko : VARCHAR(50)
  * pesel : CHAR(11) <<UK>>
  * stanowisko : VARCHAR(50)
  * data_zatrudnienia : DATE
  * pensja_podstawowa : NUMBER(10,2)
}

entity "SPRZEDAWCA" as sprzedawca {
  ' Atrybuty specyficzne
  --
  * prowizja_procent : NUMBER(5,2)
  * limit_rabatu_procent : NUMBER(5,2)
  liczba_sprzedazy : NUMBER(5)
}

entity "SERWISANT" as serwisant {
  ' Atrybuty specyficzne
  --
  * specjalizacja : VARCHAR(100)
  <<multivalued>> certyfikaty : VARCHAR(500)
  * stawka_godzinowa : NUMBER(10,2)
}

entity "SPRZEDAZ" as sprzedaz {
  * **nr_sprzedazy** : PK
  --
  * data_sprzedazy : DATE
  * cena_sprzedazy : NUMBER(10,2)
  * cena_koncowa : NUMBER(10,2)
  * metoda_platnosci : {Gotowka, Przelew, Finansowanie, Leasing}
  * status : {W_trakcie, Zakonczona, Anulowana}
}

entity "WYPOSAZENIE" as wyposazenie {
  * **id_wyposazenia** : PK
  --
  * nazwa : VARCHAR(100) <<UK>>
  * kategoria : {Bezpieczenstwo, Komfort, Multimedia}
  * dodatkowa_cena : NUMBER(10,2)
}

entity "TEST_DRIVE" as test_drive {
  ' Encja realizująca związek M:N z atrybutami
  * **data_jazdy** : PK
  --
  godzina : TIME
  nr_prawa_jazdy : VARCHAR(20)
  status : VARCHAR(20)
}

' ============ ZWIĄZKI (RELACJE) ============

' --- Związki 1:M ---
salon ||--o{ pracownik : "zatrudnia"
salon ||--o{ pojazd : "posiada"

producent ||--|{ model : "produkuje"
model ||--|{ pojazd : "jest_instancja"

klient ||--o{ sprzedaz : "dokonuje"
sprzedawca ||--o{ sprzedaz : "realizuje"
pojazd ||--o| sprzedaz : "jest_przedmiotem"

' --- Związki M:N ---

' 1. Bezpośredni związek M:N (Transformacja -> Tabela POJAZDY_WYPOSAZENIE)
pojazd }o--o{ wyposazenie : "posiada"

' 2. Związek M:N z atrybutami (Transformacja -> Tabela JAZDY_TESTOWE)
klient ||--o{ test_drive : "rezerwuje"
pojazd ||--o{ test_drive : "używany_w"

' --- Hierarchia ISA (Specjalizacja) ---
pracownik ||--o| sprzedawca : "<<ISA>>\nOverlapping\nPartial"
pracownik ||--o| serwisant : "<<ISA>>\nOverlapping\nPartial"

@enduml
